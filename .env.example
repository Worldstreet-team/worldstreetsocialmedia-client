# Copy to .env.local and fill in real values.
#   cp .env.example .env.local

# --- Clerk auth (REQUIRED) -------------------------------------------------
# From https://dashboard.clerk.com -> your app -> Configure -> API Keys.
# Must be the SAME Clerk instance the backend gateway verifies against,
# otherwise every API call returns 401 even when sign-in appears to work.
# (placeholders deliberately don't use the pk_/sk_ prefix — GitHub push
# protection pattern-matches those even when they're obviously fake)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your-clerk-publishable-key
CLERK_SECRET_KEY=your-clerk-secret-key

# Optional: keep Clerk redirects local instead of the hosted account portal.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/onboarding

# --- Backend gateway --------------------------------------------------------
# Honored everywhere: src/const.ts derives BACKEND_URL from this var (with the
# Render gateway as fallback), and every API module resolves through it.
NEXT_PUBLIC_API_URL=https://worldstreetsocialmedia-gateway-f55k.onrender.com

# --- Xstream (live streaming) ----------------------------------------------
# REQUIRED IN PRODUCTION. src/const.ts falls back to http://localhost:3001 /
# :3010, and every live call (listLiveStreamsAction, goLiveAction, the viewer
# token) is a "use server" action — so the fallback resolves on the SERVER,
# not in the visitor's browser. Unset in a deployed environment it means the
# host calling itself on a port nothing listens to: connection refused, caught,
# and the live rail renders empty while people really are broadcasting.
#
# Point these at the deployed Xstream API/web. The API is services/api in the
# xtreme-livestream repo (it ships a Dockerfile). The deployed API must also
# list this app's origin in CORS_ORIGINS and CLERK_AUTHORIZED_PARTIES, and set
# SOCIALS_GATEWAY_URL to the gateway above so live posts relay back.
# Local dev values. LEAVE THESE UNSET in production — the code falls back to
# https://livestream-api.worldstreetgold.com / https://xtreme.worldstreetgold.com.
# Setting them to localhost in a deployed environment points every visitor's
# browser at their own machine, and live chat/likes/gifts/wallet all go dark.
NEXT_PUBLIC_XSTREAM_API_URL=http://localhost:3001
NEXT_PUBLIC_XSTREAM_WEB_URL=http://localhost:3010

# PostHog analytics (phc_ keys are public project keys — safe in the client bundle)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
